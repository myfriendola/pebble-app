# Pebble Index App — environment variables
# Set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values. The app reads everything from process.env.

# The model the app uses to sort & summarize (from platform.openai.com)
OPENAI_API_KEY=

# Supabase project (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A long random string you invent — guards the public /api/capture webhook
CAPTURE_SECRET=

# Another long random string — guards the /api/cron/* scheduled jobs
CRON_SECRET=

# The app password (unlock the app for 2 weeks per device). Leave unset to
# disable the lock entirely — the app stays open.
APP_PASSWORD=

# Optional: override the OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
