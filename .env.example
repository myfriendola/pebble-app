# Pebble Index App — environment variables
# Set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values. The app reads everything from process.env.

# The model the app uses to sort & summarize (from platform.openai.com)
OPENAI_API_KEY=

# Supabase project (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A long random string you invent — guards the public /api/capture webhook
CAPTURE_SECRET=

# Another long random string — guards the /api/cron/* scheduled jobs
CRON_SECRET=

# The app password (unlock the app for 2 weeks per device). Leave unset to
# disable the lock entirely — the app stays open.
APP_PASSWORD=

# Web Push notifications (optional). Generate a keypair with:
#   npx web-push generate-vapid-keys
# then set the public + private key here. VAPID_SUBJECT is a mailto: you own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Calendar subscription (optional). A long random string you invent — it's the
# only key guarding the public /api/calendar/tasks.ics feed, so keep it secret.
# Leave unset and calendar sync stays off (the feed returns 404).
CALENDAR_TOKEN=

# Semantic search (optional). Set to 1 to turn on meaning-based search (in
# addition to keyword search, which always works). Requires the vector columns
# from schema.sql / migration.sql. Uses OpenAI embeddings (text-embedding-3-small).
# Leave unset for keyword-only search.
SEARCH_EMBEDDINGS=

# Optional: override the OpenAI model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
